# Copy to .env for local development (never commit .env). Names only here — see README.md for
# the docker-compose database and README.md/`src/config/env.validation.ts` for what each does.

NODE_ENV=development
PORT=3000

# Local Postgres via docker-compose.yml (postgres:17, host port 5433 -> container 5432).
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=denly_dev
DB_PASSWORD=denly_dev_password_change_me
DB_NAME=denly

# Copy to .env.test for e2e (`pnpm test:e2e` sets NODE_ENV=test, which loads .env.test first —
# see src/config/config.module.ts). Same Postgres container, the second database it creates on
# first init (docker/postgres-init/01-create-test-db.sql).
# DB_NAME=denly_test
